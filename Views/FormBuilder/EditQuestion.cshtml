@model SurveyFormApp.Models.SurveyQuestion
@{
    ViewData["Title"] = "Edit Pertanyaan";
    ViewData["ActiveMenu"] = "formbuilder";
    Layout = "_SidebarLayout";
    long versionId = ViewBag.VersionId;
    string optionsRaw = ViewBag.OptionsRaw;
}

@section Styles {
<style>
.sv-option-rows{display:flex;flex-direction:column;gap:8px;margin-bottom:8px;}
.sv-option-header{
  display:flex;gap:8px;align-items:center;margin-bottom:6px;
}
.sv-option-header .sv-opt-header-label,
.sv-option-header .sv-opt-header-value{
  flex:1 1 0;min-width:0;font-size:12px;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;color:var(--ink-faint);
}
.sv-option-header .sv-opt-header-spacer{flex:0 0 auto;width:22px;}
.sv-option-header .sv-opt-header-spacer-end{flex:0 0 auto;width:32px;}
.sv-option-row{display:flex;gap:8px;align-items:center;}
.sv-option-row .sv-opt-label,
.sv-option-row .sv-opt-value{flex:1 1 0;min-width:0;}
.sv-opt-remove{
  flex:0 0 auto;width:32px;height:32px;border:1px solid var(--border);background:#fff;
  border-radius:8px;color:var(--danger);font-size:16px;cursor:pointer;line-height:1;
}
.sv-opt-remove:hover{background:#fef2f2;border-color:#f3c2c2;}
.sv-add-option{margin-top:2px;}
</style>
}

<p class="sv-eyebrow">Form Builder</p>
<h1 class="sv-title">Edit Pertanyaan</h1>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="sv-card">
    <form asp-action="EditQuestion" method="post" class="row g-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="versionId" value="@versionId" />

<div class="col-md-4">
    <label class="form-label">Kode Pertanyaan <span class="text-danger">*harus unik</span></label>
    <input name="questionCode" class="form-control" value="@Model.QuestionCode" required />
</div>
<div class="col-md-8">
    <label class="form-label">Teks Pertanyaan</label>
    <input name="questionText" class="form-control" value="@Model.QuestionText" required />
</div>

<div class="col-md-3">
    <label class="form-label">Tipe Jawaban</label>
    <select name="questionType" class="form-select sv-question-type" data-target="opts-edit" data-current-type="@Model.QuestionType">
        @foreach (var t in new[] { "text", "textarea", "number", "date", "dropdown", "boolean", "photo" })
        {
            <option value="@t" selected="@(string.Equals(Model.QuestionType?.Trim(), t, StringComparison.OrdinalIgnoreCase))">@t</option>
        }
    </select>
</div>
<div class="col-md-2">
    <label class="form-label">Urutan</label>
    <input type="number" name="orderNo" class="form-control" value="@Model.OrderNo" title="Boleh sama, cuma nentuin urutan" />
</div>
<div class="col-md-3">
    <label class="form-label d-block">&nbsp;</label>
    <div class="form-check pt-2">
        <input type="checkbox" name="isRequired" value="true" class="form-check-input" id="editReq"
               checked="@Model.IsRequired" />
        <label class="form-check-label" for="editReq">Wajib diisi</label>
    </div>
</div>

<div class="col-md-6" id="opts-edit" style="display:none;">
    <label class="form-label">Opsi Dropdown</label>
    <div class="sv-option-header">
        <span class="sv-opt-header-spacer"></span>
        <span class="sv-opt-header-label">Label</span>
        <span class="sv-opt-header-value">Value</span>
        <span class="sv-opt-header-spacer-end"></span>
    </div>
    <div class="sv-option-rows" id="optrows-edit" data-target="optsRaw-edit"></div>
    <button type="button" class="sv-btn sv-btn--ghost sv-btn--sm sv-add-option" data-rows="optrows-edit">+ Tambah Opsi</button>
    <input type="hidden" name="optionsRaw" id="optsRaw-edit" value="@optionsRaw" />
    <small class="text-muted d-block mt-1">
        <strong>Label</strong> = teks yang tampil ke surveyor. <strong>Value</strong> = data yang dikirim &amp; disimpan ke database.
    </small>
</div>
        <div class="col-md-6">
            <label class="form-label">Teks Bantuan</label>
            <input name="helpText" class="form-control" value="@Model.HelpText" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Min Value</label>
            <input type="number" step="any" name="minValue" class="form-control" value="@Model.MinValue" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max Value</label>
            <input type="number" step="any" name="maxValue" class="form-control" value="@Model.MaxValue" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max Length</label>
            <input type="number" name="maxLength" class="form-control" value="@Model.MaxLength" />
        </div>
        <div class="col-md-6">
    <label class="form-label">Validation Regex (opsional)</label>
    <input type="text" name="validationRegex" class="form-control" value="@Model.ValidationRegex" placeholder="cth: ^[0-9]{10}$" />
</div>
        <div class="col-md-3">
            <label class="form-label">Placeholder</label>
            <input name="placeholder" class="form-control" value="@Model.Placeholder" />
        </div>

        <div class="col-12 mt-2">
            <button type="submit" class="sv-btn sv-btn--primary">Simpan Perubahan</button>
            <a asp-action="Manage" asp-route-versionId="@versionId" class="sv-btn sv-btn--ghost">Batal</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    var select = document.querySelector('.sv-question-type');
    var target = document.getElementById('opts-edit');

    // fallback: paksa value select sesuai tipe pertanyaan saat ini
    var currentType = (select.dataset.currentType || '').trim().toLowerCase();
    var hasMatch = Array.from(select.options).some(function (opt) {
        return opt.value.toLowerCase() === currentType;
    });
    if (hasMatch) {
        select.value = currentType;
    }

    function toggle() {
        target.style.display = select.value === 'dropdown' ? '' : 'none';
    }
    toggle();
    select.addEventListener('change', toggle);

    initAllOptionRows();
});

function initAllOptionRows() {
    document.querySelectorAll('.sv-option-rows').forEach(function (container) {
        if (container.dataset.init) return;
        container.dataset.init = "1";
        initOptionRows(container);
    });
}

function initOptionRows(container) {
    var hidden = document.getElementById(container.dataset.target);
    var addBtn = document.querySelector('.sv-add-option[data-rows="' + container.id + '"]');

    function sync() {
        var pairs = [];
        container.querySelectorAll('.sv-option-row').forEach(function (row) {
            var label = row.querySelector('.sv-opt-label').value.trim();
            var value = row.querySelector('.sv-opt-value').value.trim();
            if (!label && !value) return;
            pairs.push(label + ':' + (value || label));
        });
        hidden.value = pairs.join(', ');
    }

    function addRow(label, value) {
        var row = document.createElement('div');
        row.className = 'sv-option-row';

        var labelInput = document.createElement('input');
        labelInput.type = 'text';
        labelInput.className = 'form-control sv-opt-label';
        labelInput.placeholder = 'Label (tampil di form)';
        labelInput.value = label || '';

        var valueInput = document.createElement('input');
        valueInput.type = 'text';
        valueInput.className = 'form-control sv-opt-value';
        valueInput.placeholder = 'Value (disimpan ke DB)';
        valueInput.value = value || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'sv-opt-remove';
        removeBtn.innerHTML = '&times;';
        removeBtn.title = 'Hapus opsi';
removeBtn.addEventListener('click', function () {
    var label = row.querySelector('.sv-opt-label').value.trim();
    var value = row.querySelector('.sv-opt-value').value.trim();
    var desc = label || value ? `"${label || value}"` : 'opsi ini';
    if (!confirm('Hapus ' + desc + '?')) return;
    row.remove();
    sync();
});

        labelInput.addEventListener('input', sync);
        valueInput.addEventListener('input', sync);

        row.appendChild(labelInput);
        row.appendChild(valueInput);
        row.appendChild(removeBtn);
        container.appendChild(row);
    }

    // prepopulate kalau hidden field sudah ada isi (mode edit)
    if (hidden.value) {
        hidden.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean).forEach(function (pair) {
            var parts = pair.split(':');
            addRow(parts[0], parts.length > 1 ? parts[1] : parts[0]);
        });
        sync();
    }

    if (addBtn) {
        addBtn.addEventListener('click', function () {
            addRow('', '');
            sync();
        });
    }
}
</script>
}