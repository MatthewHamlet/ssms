@model SurveyFormApp.Models.SurveyFormVersion
@{
    ViewData["Title"] = "Kelola Pertanyaan";
    ViewData["ActiveMenu"] = "formbuilder";
    Layout = "_SidebarLayout";
}

@section Styles {
<style>
.sv-cond-field{transition:none;}
.sv-cond-field[hidden]{display:none !important;}

.sv-section-card{position:relative;}
.sv-section-header{
  position:sticky;
  top:var(--topbar-h);
  z-index:400;
  background:#fff;
  padding:6px 0;
  margin:-6px 0 12px;
}
.sv-option-rows{
  display:flex;flex-direction:column;gap:8px;margin-bottom:8px;
  max-height:150px;
  overflow-y:auto;
  padding-right:4px;
}
.sv-option-header{
  display:flex;gap:8px;align-items:center;margin-bottom:6px;
}
.sv-option-header .sv-opt-header-label,
.sv-option-header .sv-opt-header-value{
  flex:1 1 0;min-width:0;font-size:12px;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;color:var(--ink-faint);
}
.sv-option-header .sv-opt-header-spacer{flex:0 0 auto;width:22px;}
.sv-option-header .sv-opt-header-spacer-end{flex:0 0 auto;width:32px;}
.sv-option-rows::-webkit-scrollbar{width:6px;}
.sv-option-rows::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:3px;}
.sv-option-row{
  display:flex;gap:8px;align-items:center;background:#fff;
}
.sv-option-row.dragging{opacity:.4;}
.sv-opt-handle{
  flex:0 0 auto;width:22px;height:38px;display:flex;align-items:center;justify-content:center;
  cursor:grab;color:var(--ink-faint);font-size:14px;
}
.sv-opt-handle:active{cursor:grabbing;}
.sv-option-row .sv-opt-label,
.sv-option-row .sv-opt-value{flex:1 1 0;min-width:0;}
.sv-opt-remove{
  flex:0 0 auto;width:32px;height:32px;border:1px solid var(--border);background:#fff;
  border-radius:8px;color:var(--danger);font-size:16px;cursor:pointer;line-height:1;
}
.sv-opt-remove:hover{background:#fef2f2;border-color:#f3c2c2;}
.sv-add-option{margin-top:2px;}
.sv-optional-box{background:#fafbfc;border:1px solid var(--border);border-radius:10px;padding:12px 14px;}

/* drag & drop pertanyaan */
.sv-drag-col{width:34px;}
.sv-drag-handle{
  cursor:grab;color:var(--ink-faint);font-size:16px;
  display:inline-flex;align-items:center;justify-content:center;
  width:28px;height:28px;
}
.sv-drag-handle:active{cursor:grabbing;}
.sv-table tbody tr.sv-row-ghost{opacity:.4;background:var(--purple-tint);}
.sv-table tbody tr.sv-row-drag{background:#fff;box-shadow:var(--shadow-md);}
</style>
}

<p class="sv-eyebrow">Form Builder</p>
<h1 class="sv-title">@Model.Form.FormName <span class="text-muted">v@(Model.VersionNo)</span></h1>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<p>
    <span class="sv-badge @(Model.IsPublished ? "sv-badge--published" : "sv-badge--draft")">
        @(Model.IsPublished ? "Published" : "Draft")
    </span>
</p>

@foreach (var sec in Model.SurveySections.OrderBy(s => s.OrderNo))
{
<div class="sv-card sv-section-card">
    <div class="sv-section-header d-flex justify-content-between align-items-center">
        <strong>@sec.SectionTitle</strong>
        <div class="d-flex gap-2">
            <button type="button" class="sv-btn sv-btn--primary sv-btn--sm js-open-add-question" data-section-id="@sec.Id">
                + Tambah Pertanyaan
            </button>
            <form asp-action="DeleteSection" method="post" onsubmit="return confirm('Hapus section ini beserta semua pertanyaannya?');" class="d-inline">
                <input type="hidden" name="sectionId" value="@sec.Id" />
                <input type="hidden" name="versionId" value="@Model.Id" />
                <button class="sv-btn sv-btn--danger sv-btn--sm">Hapus Section</button>
            </form>
        </div>
    </div>

        <table class="sv-table">
            <thead><tr><th class="sv-drag-col"></th><th>#</th><th>Pertanyaan</th><th>Tipe</th><th>Wajib</th><th></th></tr></thead>
            <tbody class="js-question-tbody" data-section-id="@sec.Id">
            @foreach (var q in sec.SurveyQuestions.OrderBy(q => q.OrderNo))
            {
                <tr data-question-id="@q.Id">
                    <td class="sv-drag-col"><span class="sv-drag-handle" title="Geser buat urutin"><i class="bi bi-grip-vertical"></i></span></td>
                    <td class="sv-order-no">@q.OrderNo</td>
                    <td>
                        @q.QuestionText
                        @if (q.SurveyQuestionOptions.Any())
                        {
                            <div class="small text-muted">Opsi: @string.Join(", ", q.SurveyQuestionOptions.OrderBy(o => o.OrderNo).Select(o => o.OptionLabel))</div>
                        }
                    </td>
                    <td>@q.QuestionType</td>
                    <td>@(q.IsRequired ? "Ya" : "Tidak")</td>
                    <td class="text-nowrap">
                        <button type="button" class="sv-btn sv-btn--ghost sv-btn--sm js-edit-question" data-question-id="@q.Id">Edit</button>
                        <form asp-action="DeleteQuestion" method="post" style="display:inline" onsubmit="return confirm('Hapus pertanyaan ini?');">
                            <input type="hidden" name="questionId" value="@q.Id" />
                            <input type="hidden" name="versionId" value="@Model.Id" />
                            <button class="sv-btn sv-btn--danger sv-btn--sm">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="sv-card">
    <strong class="d-block mb-3">+ Tambah Section Baru</strong>
    <form asp-action="AddSection" method="post" class="row g-2">
        <input type="hidden" name="versionId" value="@Model.Id" />
        <div class="col-md-3"><input name="sectionCode" class="form-control" placeholder="Kode Section" required /></div>
        <div class="col-md-6"><input name="sectionTitle" class="form-control" placeholder="Judul Section" required /></div>
        <div class="col-md-2"><input type="number" name="orderNo" class="form-control" value="@(Model.SurveySections.Count)" /></div>
        <div class="col-md-1"><button type="submit" class="sv-btn sv-btn--primary">Tambah</button></div>
    </form>
</div>

<div class="mt-3">
    <a asp-action="Versions" asp-route-formId="@Model.FormId" class="sv-btn sv-btn--ghost">Kembali ke Daftar Versi</a>
    @if (!Model.IsPublished)
    {
<form asp-action="Publish" method="post" style="display:inline" onsubmit="return confirm('Publish versi ini? Versi lain yang sedang published akan otomatis di-unpublish.');">
    <input type="hidden" name="versionId" value="@Model.Id" />
    <button type="submit" class="sv-btn sv-btn--submit">Publish Form Ini</button>
</form>
    }
</div>

<!-- Modal Tambah Pertanyaan -->
<div class="modal fade" id="addQuestionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Tambah Pertanyaan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form asp-action="AddQuestion" method="post" class="row g-2" id="addQuestionForm">
            <input type="hidden" name="sectionId" id="add-sectionId" value="" />
            <input type="hidden" name="versionId" value="@Model.Id" />

            <div class="col-md-6">
                <label class="form-label">Kode Pertanyaan <span class="text-danger">*harus unik</span></label>
                <input name="questionCode" class="form-control" placeholder="cth: Q_NAMA_DEBITUR" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Teks Pertanyaan</label>
                <input name="questionText" class="form-control" placeholder="Nama lengkap debitur?" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Tipe Jawaban</label>
                <select name="questionType" class="form-select sv-question-type" data-target="opts-add" data-scope="add" id="add-questionType">
                    <option value="text">Text</option>
                    <option value="textarea">Textarea</option>
                    <option value="number">Number</option>
                    <option value="date">Date</option>
                    <option value="dropdown">Dropdown</option>
                    <option value="boolean">Boolean</option>
                    <option value="photo">Photo</option>
                </select>
            </div>
            <div class="col-md-8">
                <label class="form-label d-block">&nbsp;</label>
                <div class="form-check pt-2">
                    <input type="checkbox" name="isRequired" value="true" class="form-check-input" id="add-req" />
                    <label class="form-check-label" for="add-req">Wajib diisi</label>
                </div>
            </div>

            <div class="col-md-6 sv-opts-field" id="opts-add" style="display:none;">
                <label class="form-label">Opsi Dropdown</label>
                <div class="sv-option-header">
                    <span class="sv-opt-header-spacer"></span>
                    <span class="sv-opt-header-label">Label</span>
                    <span class="sv-opt-header-value">Value</span>
                    <span class="sv-opt-header-spacer-end"></span>
                </div>
                <div class="sv-option-rows" id="optrows-add" data-target="optsRaw-add"></div>
                <button type="button" class="sv-btn sv-btn--ghost sv-btn--sm sv-add-option" data-rows="optrows-add">+ Tambah Opsi</button>
                <input type="hidden" name="optionsRaw" id="optsRaw-add" />
                <small class="text-muted d-block mt-1">
                    <strong>Label</strong> = teks yang tampil ke surveyor. <strong>Value</strong> = data yang dikirim &amp; disimpan ke database.
                </small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Teks Bantuan (opsional)</label>
                <input name="helpText" class="form-control" placeholder="Muncul di bawah field, buat panduan surveyor" />
            </div>

            <div class="col-12">
                <div class="sv-optional-box">
                    <small class="text-muted d-block mb-2">Opsional — batasan &amp; validasi jawaban (menyesuaikan tipe jawaban):</small>
                    <div class="row g-2">
                        <div class="col-md-3 sv-cond-field" data-scope="add" data-show-for="number" hidden>
                            <label class="form-label">Min Value</label>
                            <input type="number" step="any" name="minValue" class="form-control" placeholder="cth: 0" />
                        </div>
                        <div class="col-md-3 sv-cond-field" data-scope="add" data-show-for="number" hidden>
                            <label class="form-label">Max Value</label>
                            <input type="number" step="any" name="maxValue" class="form-control" placeholder="cth: 100" />
                        </div>
                        <div class="col-md-3 sv-cond-field" data-scope="add" data-show-for="text,textarea" hidden>
                            <label class="form-label">Max Length</label>
                            <input type="number" name="maxLength" class="form-control" placeholder="cth: 200" />
                        </div>
                        <div class="col-md-3 sv-cond-field" data-scope="add" data-show-for="text,textarea" hidden>
                            <label class="form-label">Validation Regex</label>
                            <input type="text" name="validationRegex" class="form-control" placeholder="cth: ^[0-9]+$" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Placeholder</label>
                            <input name="placeholder" class="form-control" placeholder="cth: Masukkan nama..." />
                        </div>
                    </div>
                </div>
            </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="sv-btn sv-btn--ghost" data-bs-dismiss="modal">Batal</button>
        <button type="submit" form="addQuestionForm" class="sv-btn sv-btn--primary">Simpan Pertanyaan</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Edit Pertanyaan -->
<div class="modal fade" id="editQuestionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Pertanyaan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="editModalBody">
        <div class="text-center text-muted py-4">Memuat...</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="sv-btn sv-btn--ghost" data-bs-dismiss="modal">Batal</button>
        <button type="submit" form="editQuestionForm" class="sv-btn sv-btn--primary">Simpan Perubahan</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.sv-question-type').forEach(function (select) {
        updateConditionalFields(select);
        select.addEventListener('change', function () {
            updateConditionalFields(select);
        });
    });

    initAllOptionRows();
    initSortableTables();
    initAddQuestionButtons();
    initEditQuestionButtons();
});

function updateConditionalFields(select) {
    var scope = select.dataset.scope;
    var type = select.value;

    var optsTarget = document.getElementById(select.dataset.target);
    if (optsTarget) {
        optsTarget.style.display = type === 'dropdown' ? '' : 'none';
    }

    document.querySelectorAll('.sv-cond-field[data-scope="' + scope + '"]').forEach(function (field) {
        var allowedTypes = (field.dataset.showFor || '').split(',').map(function (s) { return s.trim(); });
        var shouldShow = allowedTypes.indexOf(type) !== -1;
        field.hidden = !shouldShow;

        if (!shouldShow) {
            field.querySelectorAll('input').forEach(function (inp) { inp.value = ''; });
        }
    });
}

function initAllOptionRows() {
    document.querySelectorAll('.sv-option-rows').forEach(function (container) {
        if (container.dataset.init) return;
        container.dataset.init = "1";
        initOptionRows(container);
    });
}

function initOptionRows(container) {
    var hidden = document.getElementById(container.dataset.target);
    var addBtn = document.querySelector('.sv-add-option[data-rows="' + container.id + '"]');
    var draggedRow = null;

    function sync() {
        var pairs = [];
        container.querySelectorAll('.sv-option-row').forEach(function (row) {
            var label = row.querySelector('.sv-opt-label').value.trim();
            var value = row.querySelector('.sv-opt-value').value.trim();
            if (!label && !value) return;
            pairs.push(label + ':' + (value || label));
        });
        hidden.value = pairs.join(', ');
    }

    function getDragAfterElement(y) {
        var rows = Array.from(container.querySelectorAll('.sv-option-row:not(.dragging)'));
        return rows.reduce(function (closest, child) {
            var box = child.getBoundingClientRect();
            var offset = y - box.top - box.height / 2;
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            }
            return closest;
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    function attachDrag(row) {
        var handle = row.querySelector('.sv-opt-handle');
        row.draggable = false;

        handle.addEventListener('mousedown', function () {
            row.draggable = true;
        });

        row.addEventListener('dragstart', function (e) {
            draggedRow = row;
            row.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
        });

        row.addEventListener('dragend', function () {
            row.classList.remove('dragging');
            row.draggable = false;
            draggedRow = null;
            sync();
        });
    }

    container.addEventListener('dragover', function (e) {
        e.preventDefault();
        if (!draggedRow) return;
        var afterElement = getDragAfterElement(e.clientY);
        if (afterElement == null) {
            container.appendChild(draggedRow);
        } else {
            container.insertBefore(draggedRow, afterElement);
        }
    });

    function addRow(label, value) {
        var row = document.createElement('div');
        row.className = 'sv-option-row';

        var handle = document.createElement('span');
        handle.className = 'sv-opt-handle';
        handle.innerHTML = '<i class="bi bi-grip-vertical"></i>';

        var labelInput = document.createElement('input');
        labelInput.type = 'text';
        labelInput.className = 'form-control sv-opt-label';
        labelInput.placeholder = 'Label (tampil di form)';
        labelInput.value = label || '';

        var valueInput = document.createElement('input');
        valueInput.type = 'text';
        valueInput.className = 'form-control sv-opt-value';
        valueInput.placeholder = 'Value (disimpan ke DB)';
        valueInput.value = value || '';

        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'sv-opt-remove';
        removeBtn.innerHTML = '&times;';
        removeBtn.title = 'Hapus opsi';
        removeBtn.addEventListener('click', function () {
            var l = labelInput.value.trim();
            var v = valueInput.value.trim();
            if (l || v) {
                if (!confirm('Hapus opsi "' + (l || v) + '"?')) return;
            }
            row.remove();
            sync();
        });

        labelInput.addEventListener('input', sync);
        valueInput.addEventListener('input', sync);

        row.appendChild(handle);
        row.appendChild(labelInput);
        row.appendChild(valueInput);
        row.appendChild(removeBtn);

        attachDrag(row);
        container.appendChild(row);
    }

    if (hidden.value) {
        hidden.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean).forEach(function (pair) {
            var parts = pair.split(':');
            addRow(parts[0], parts.length > 1 ? parts[1] : parts[0]);
        });
        sync();
    }

    if (addBtn) {
        addBtn.addEventListener('click', function () {
            addRow('', '');
            sync();
        });
    }
}

function initAddQuestionButtons() {
    document.querySelectorAll('.js-open-add-question').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var form = document.getElementById('addQuestionForm');
            form.reset();
            document.getElementById('add-sectionId').value = btn.dataset.sectionId;

            var optRows = document.getElementById('optrows-add');
            if (optRows) optRows.innerHTML = '';
            var optsRaw = document.getElementById('optsRaw-add');
            if (optsRaw) optsRaw.value = '';

            var select = document.getElementById('add-questionType');
            select.value = 'text';
            updateConditionalFields(select);

            var modal = new bootstrap.Modal(document.getElementById('addQuestionModal'));
            modal.show();
        });
    });
}

function initEditQuestionButtons() {
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-edit-question');
        if (!btn) return;

        var id = btn.dataset.questionId;
        var body = document.getElementById('editModalBody');
        body.innerHTML = '<div class="text-center text-muted py-4">Memuat...</div>';

        var modal = new bootstrap.Modal(document.getElementById('editQuestionModal'));
        modal.show();

        fetch('/FormBuilder/EditQuestionPartial/' + id)
            .then(function (res) {
                if (!res.ok) throw new Error('Gagal memuat data pertanyaan.');
                return res.text();
            })
            .then(function (html) {
                body.innerHTML = html;
                initEditModalForm();
            })
            .catch(function (err) {
                body.innerHTML = '<div class="alert alert-danger mb-0">' + err.message + '</div>';
            });
    });
}

function initEditModalForm() {
    var select = document.querySelector('#editModalBody .sv-question-type');
    if (select) {
        var currentType = (select.dataset.currentType || '').trim().toLowerCase();
        var hasMatch = Array.from(select.options).some(function (opt) {
            return opt.value.toLowerCase() === currentType;
        });
        if (hasMatch) select.value = currentType;

        updateConditionalFields(select);
        select.addEventListener('change', function () {
            updateConditionalFields(select);
        });
    }
    initAllOptionRows();
}

function initSortableTables() {
    document.querySelectorAll('.js-question-tbody').forEach(function (tbody) {
        new Sortable(tbody, {
            handle: '.sv-drag-handle',
            animation: 150,
            ghostClass: 'sv-row-ghost',
            dragClass: 'sv-row-drag',
            onEnd: function () {
                var sectionId = tbody.dataset.sectionId;
                var rows = Array.from(tbody.querySelectorAll('tr[data-question-id]'));
                var ids = rows.map(function (tr) { return parseInt(tr.dataset.questionId, 10); });

                rows.forEach(function (tr, idx) {
                    var cell = tr.querySelector('.sv-order-no');
                    if (cell) cell.textContent = idx;
                });

                fetch('/FormBuilder/ReorderQuestions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sectionId: parseInt(sectionId, 10), questionIds: ids })
                }).then(function (res) {
                    if (!res.ok) throw new Error();
                }).catch(function () {
                    alert('Gagal menyimpan urutan pertanyaan. Coba refresh halaman lalu ulangi.');
                });
            }
        });
    });
}
</script>
}