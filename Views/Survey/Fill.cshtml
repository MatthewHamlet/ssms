@model SurveyFormApp.Models.SurveyAssignment
@{
    ViewData["Title"] = "Isi Survey";
    ViewData["ActiveMenu"] = "surveyindex";
    Layout = "_SidebarLayout";
    var currentSurveyor = ViewData["CurrentSurveyor"] as string;

    var sectionsOrdered = Model.FormVersion.SurveySections.OrderBy(s => s.OrderNo).ToList();

    var allQuestions = Model.FormVersion.SurveySections.SelectMany(s => s.SurveyQuestions).ToList();
    var rules = allQuestions
        .SelectMany(q => q.SurveyQuestionRuleQuestions.Select(r => new
        {
            questionId = q.Id,
            dependsOnQuestionId = r.DependsOnQuestionId,
            operatorType = r.Operator,
            value = r.Value,
            action = r.Action
        }))
        .ToList();

    var rulesJson = System.Text.Json.JsonSerializer.Serialize(rules);
    var sectionTitlesJson = System.Text.Json.JsonSerializer.Serialize(sectionsOrdered.Select(s => s.SectionTitle));
}

@section Styles {
<style>
.sv-inline-box select{display:none !important;}

.sv-inline-box select:not([data-enhanced]){
  display:block !important;
  flex:1 1 auto;
  min-width:0;
  font-family:inherit;
  font-size:14.5px;
  color:var(--ink);
  background-color:#fff !important;
  background-image:url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='%236b7280' d='M8 11 3 6h10z'/%3e%3c/svg%3e");
  background-repeat:no-repeat;
  background-position:right 2px center;
  background-size:14px;
  border:none;
  outline:none;
  padding:0 22px 0 0;
  -webkit-appearance:none;
  -moz-appearance:none;
  appearance:none;
  cursor:pointer;
}
.sv-inline-box select:not([data-enhanced])::-ms-expand{display:none;}
.sv-inline-box select:not([data-enhanced]) option{color:var(--ink);background:#fff;}

.sv-select{position:relative;flex:1 1 auto;min-width:0;}
.sv-select__trigger{
  display:flex;align-items:center;justify-content:space-between;
  width:100%;cursor:pointer;font-size:14.5px;color:var(--ink);
  user-select:none;outline:none;
}
.sv-select__trigger.is-empty{font-size:11px;color:var(--ink-faint);transition:.15s;flex-shrink:0;margin-left:10px;}
.sv-select.open .sv-select__trigger i{transform:rotate(180deg);color:var(--purple);}
.sv-select.disabled .sv-select__trigger{opacity:.5;cursor:not-allowed;pointer-events:none;}

.sv-select__panel{
  position:absolute;top:calc(100% + 8px);left:-14px;right:-14px;
  background:#fff;border:1px solid var(--border);border-radius:12px;
  box-shadow:var(--shadow-md);padding:6px;z-index:50;
  max-height:240px;overflow-y:auto;
  opacity:0;transform:translateY(-6px);pointer-events:none;
  transition:.15s var(--ease);
}
.sv-select.open .sv-select__panel{opacity:1;transform:translateY(0);pointer-events:auto;}

.sv-select__option{
  padding:10px 12px;border-radius:8px;font-size:14px;color:var(--ink);cursor:pointer;
}
.sv-select__option:hover{background:var(--purple-tint);}
.sv-select__option.selected{background:var(--purple);color:#fff;font-weight:600;}
.sv-select--invalid .sv-select__trigger{
  animation:sfShake .4s;
  border-radius:8px;
  box-shadow:0 0 0 2px var(--danger);
}
@@keyframes sfShake{
  0%,100%{transform:translateX(0);}
  25%{transform:translateX(-4px);}
  75%{transform:translateX(4px);}
}

.sv-stepper{display:flex;align-items:center;margin-bottom:28px;overflow-x:auto;}
.sv-step-item{display:flex;align-items:center;gap:8px;white-space:nowrap;flex:0 0 auto;cursor:pointer;}
.sv-step-circle{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;background:#eef0f3;color:var(--ink-faint);flex:0 0 auto;}
.sv-step-label{font-size:14px;font-weight:600;color:var(--ink-faint);}
.sv-step-line{flex:1 1 auto;height:1px;background:var(--border);margin:0 14px;min-width:20px;}
.sv-step-item.is-active .sv-step-circle{background:var(--purple);color:#fff;}
.sv-step-item.is-active .sv-step-label{color:var(--purple-dark);}
.sv-step-item.is-done .sv-step-circle{background:var(--sf-gold);color:#1f2937;}
.sv-step-item.is-done .sv-step-label{color:var(--ink);}

.wizard-step{display:none;}
.wizard-step.active{display:block;}

.sv-section-title{font-size:16px;font-weight:700;color:var(--ink);margin:0 0 20px;}

.sv-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px 28px;}
.sv-field{margin-bottom:0;}
.sv-field.sv-full{grid-column:1 / -1;}

.sv-inline-box{
  display:flex;align-items:center;gap:10px;border:1px solid var(--border);
  border-radius:var(--r);padding:12px 14px;background:#fff;height:100%;
  transition:.15s;
}
.sv-inline-box:focus-within{border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-tint);}
.sv-inline-box__label{font-weight:700;font-size:14.5px;color:var(--ink);flex:0 0 auto;white-space:nowrap;}
.sv-inline-box__label .req{color:var(--danger);margin-left:2px;}
.sv-inline-box input,.sv-inline-box select{flex:1 1 auto;border:none;outline:none;font-family:inherit;font-size:14.5px;color:var(--ink);background:transparent;appearance:none;min-width:0;}
.sv-inline-box input::placeholder{color:var(--ink-faint);}
.sv-inline-box select{cursor:pointer;}

.sv-stack-label{display:block;font-weight:700;font-size:14.5px;color:var(--ink);margin:0 0 8px;}
.sv-stack-label .req{color:var(--danger);margin-left:2px;}

.sv-textarea{
  width:100%;font-family:inherit;font-size:14.5px;color:var(--ink);
  border:1px solid var(--border);border-radius:var(--r);padding:12px 14px;
  min-height:96px;resize:vertical;transition:.15s;
}
.sv-textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-tint);}
.sv-textarea::placeholder{color:var(--ink-faint);}

.sv-help{margin:6px 0 0;font-size:12.5px;color:var(--ink-soft);}

.sv-upload{border:1.5px dashed #d1d5db;border-radius:12px;padding:30px 20px;text-align:center;background:#fff;transition:.15s;}
.sv-upload:focus-within,.sv-upload:hover{border-color:var(--purple);background:var(--purple-tint);}
.sv-upload input[type="file"]{font-family:inherit;font-size:13.5px;color:var(--ink-soft);}
.sv-upload__icon{color:var(--purple);margin-bottom:8px;}
.sv-note--warning{margin:12px 0 0;font-size:12.5px;color:#8a5a00;background:#fff6e0;border:1px solid #f0d48a;border-radius:6px;padding:8px 10px;text-align:left;}

.sv-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:28px;flex-wrap:wrap;}

.sv-assign-info{
  display:flex;flex-wrap:wrap;gap:20px;margin-bottom:18px;
  background:#fafbfc;border:1px solid var(--border);border-radius:10px;padding:12px 16px;
}
.sv-assign-info__item{font-size:13.5px;color:var(--ink-soft);}
.sv-assign-info__item strong{color:var(--ink);}

@@media(max-width:900px){.sv-grid{grid-template-columns:1fr;}}
@@media(max-width:768px){
  .sv-actions{justify-content:stretch;}
  .sv-actions .sv-btn{flex:1;text-align:center;}
}
</style>
}

<p class="sv-eyebrow">Survei Digital</p>
<h1 class="sv-title">Isi Survey</h1>

@if (ViewData["Errors"] is List<string> errors && errors.Count > 0)
{
    <div class="alert alert-danger">
        <strong>Mohon periksa kembali isian berikut:</strong>
        <ul class="mb-0">
            @foreach (var err in errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<div class="sv-card">
    <div class="sv-assign-info">
        <span class="sv-assign-info__item">Application ID: <strong>@Model.ApplicationId</strong></span>
        <span class="sv-assign-info__item">Surveyor: <strong>@(Model.SurveyorId ?? currentSurveyor)</strong></span>
        @if (!string.IsNullOrWhiteSpace(Model.BranchId))
        {
            <span class="sv-assign-info__item">Cabang: <strong>@Model.BranchId</strong></span>
        }
    </div>

    <div class="sv-stepper" id="stepper"></div>

    <form asp-action="Fill" method="post" enctype="multipart/form-data" id="surveyForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="assignmentId" value="@Model.Id" />

        <input type="hidden" name="latitude" id="sfLatitude" />
        <input type="hidden" name="longitude" id="sfLongitude" />
        <input type="hidden" name="deviceId" id="sfDeviceId" />
        <input type="hidden" name="appVersion" id="sfAppVersion" value="1.0.0" />
        <input type="hidden" name="durationSeconds" id="sfDuration" />

        @{ var stepIndex = 0; }

        @foreach (var sec in sectionsOrdered)
        {
            <div class="wizard-step @(stepIndex == 0 ? "active" : "")" data-step="@stepIndex">
                <h2 class="sv-section-title">@sec.SectionTitle</h2>

                <div class="sv-grid">
                    @foreach (var q in sec.SurveyQuestions.OrderBy(q => q.OrderNo))
                    {
                        var fieldName = $"answers[{q.Id}]";
                        var qType = q.QuestionType?.ToLower() ?? "text";
                        var isFull = qType == "textarea" || qType == "photo";

                        <div class="sv-field question-wrapper @(isFull ? "sv-full" : "")" data-question-id="@q.Id">

                            @if (qType == "textarea")
                            {
                                <label class="sv-stack-label">@q.QuestionText @if (q.IsRequired) { <span class="req">*</span> }</label>
                                <textarea name="@fieldName" class="sv-textarea"
                                          placeholder="@q.Placeholder" maxlength="@q.MaxLength"
                                          required="@q.IsRequired"></textarea>
                            }
                            else if (qType == "number")
                            {
                                <div class="sv-inline-box">
                                    <span class="sv-inline-box__label">@q.QuestionText@if (q.IsRequired) { <span class="req">*</span> }:</span>
                                    <input type="number" name="@fieldName"
                                           placeholder="@q.Placeholder"
                                           min="@q.MinValue" max="@q.MaxValue"
                                           required="@q.IsRequired" />
                                </div>
                            }
                            else if (qType == "date")
                            {
                                <div class="sv-inline-box">
                                    <span class="sv-inline-box__label">@q.QuestionText@if (q.IsRequired) { <span class="req">*</span> }:</span>
                                    <input type="date" name="@fieldName" required="@q.IsRequired" />
                                </div>
                            }
                            else if (qType == "dropdown")
                            {
                                <div class="sv-inline-box">
                                    <span class="sv-inline-box__label">@q.QuestionText@if (q.IsRequired) { <span class="req">*</span> }:</span>
                                    <select name="@fieldName" required="@q.IsRequired">
                                        <option value="">-- Pilih --</option>
                                        @foreach (var opt in q.SurveyQuestionOptions.OrderBy(o => o.OrderNo))
                                        {
                                            <option value="@opt.OptionValue">@opt.OptionLabel</option>
                                        }
                                    </select>
                                </div>
                            }
                            else if (qType == "boolean")
                            {
                                <div class="sv-inline-box">
                                    <span class="sv-inline-box__label">@q.QuestionText@if (q.IsRequired) { <span class="req">*</span> }:</span>
                                    <select name="@fieldName" required="@q.IsRequired">
                                        <option value="">-- Pilih --</option>
                                        <option value="true">Ya</option>
                                        <option value="false">Tidak</option>
                                    </select>
                                </div>
                            }
                            else if (qType == "photo")
                            {
                                var photoFieldName = $"photos[{q.Id}]";
                                <label class="sv-stack-label">@q.QuestionText @if (q.IsRequired) { <span class="req">*</span> }</label>
                                <div class="sv-upload">
                                    <div class="sv-upload__icon">
                                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/></svg>
                                    </div>
                                    <input type="file" name="@photoFieldName" accept="image/*" required="@q.IsRequired" />
                                    <p class="sv-note--warning">
                                        Catatan: upload foto belum tersimpan otomatis, perlu penanganan tambahan di Controller.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="sv-inline-box">
                                    <span class="sv-inline-box__label">@q.QuestionText@if (q.IsRequired) { <span class="req">*</span> }:</span>
                                    <input type="text" name="@fieldName"
                                           placeholder="@q.Placeholder" maxlength="@q.MaxLength"
                                           required="@q.IsRequired" />
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(q.HelpText))
                            {
                                <p class="sv-help">@q.HelpText</p>
                            }
                        </div>
                    }
                </div>
            </div>
            stepIndex++;
        }

        <div class="sv-actions">
            <button type="button" id="btnPrev" class="sv-btn sv-btn--ghost" disabled>Sebelumnya</button>
            <button type="button" id="btnNext" class="sv-btn sv-btn--primary">Selanjutnya</button>
            <button type="submit" id="btnSubmit" class="sv-btn sv-btn--submit" style="display: none;">Submit Survey</button>
        </div>
    </form>
</div>

<script id="sv-rules-data" type="application/json">@Html.Raw(rulesJson)</script>
<script id="sv-titles-data" type="application/json">@Html.Raw(sectionTitlesJson)</script>

@section Scripts {
<script>
    const surveyRules = JSON.parse(document.getElementById('sv-rules-data').textContent);
    const sectionTitles = JSON.parse(document.getElementById('sv-titles-data').textContent);
    const steps = Array.from(document.querySelectorAll(".wizard-step"));
    const totalSteps = steps.length;
    let currentStep = 0;
    const sfStartTime = Date.now();

    function getFieldValue(questionId) {
        const el = document.querySelector(`[name="answers[${questionId}]"]`);
        return el ? el.value : null;
    }

    function evaluateCondition(rule) {
        const currentValue = getFieldValue(rule.dependsOnQuestionId);
        if (currentValue === null || currentValue === "") return false;

        const op = (rule.operatorType || "EQUAL").toUpperCase().trim();
        const target = (rule.value ?? "").trim();

        switch (op) {
            case "EQUAL":
            case "=":
            case "==":
            case "EQUALS":
                return currentValue.toString().toLowerCase() === target.toLowerCase();
            case "NOT_EQUAL":
            case "!=":
                return currentValue.toString().toLowerCase() !== target.toLowerCase();
            case "CONTAINS":
                return currentValue.toLowerCase().includes(target.toLowerCase());
            case "GREATER_THAN":
            case ">":
                return parseFloat(currentValue) > parseFloat(target);
            case "LESS_THAN":
            case "<":
                return parseFloat(currentValue) < parseFloat(target);
            case ">=":
                return parseFloat(currentValue) >= parseFloat(target);
            case "<=":
                return parseFloat(currentValue) <= parseFloat(target);
            default:
                return currentValue.toString().toLowerCase() === target.toLowerCase();
        }
    }

    function isRuleHidden(questionId) {
        const rulesForQuestion = surveyRules.filter(r => r.questionId === questionId);
        if (rulesForQuestion.length === 0) return false;

        return !rulesForQuestion.some(rule => {
            const conditionMet = evaluateCondition(rule);
            const action = (rule.action || "SHOW").toUpperCase();
            return action === "HIDE" ? !conditionMet : conditionMet;
        });
    }

    function applyQuestionRules() {
        document.querySelectorAll(".question-wrapper").forEach(wrapper => {
            const qId = parseInt(wrapper.dataset.questionId, 10);
            const hidden = isRuleHidden(qId);

            wrapper.style.display = hidden ? "none" : "";
            wrapper.querySelectorAll("input, select, textarea").forEach(inp => {
                inp.dataset.ruleHidden = hidden ? "1" : "0";
            });
        });
    }

    function renderStepper() {
        const container = document.getElementById("stepper");
        container.innerHTML = "";
        sectionTitles.forEach((title, i) => {
            const item = document.createElement("div");
            item.className = "sv-step-item" +
                (i === currentStep ? " is-active" : "") +
                (i < currentStep ? " is-done" : "");

            const circle = document.createElement("span");
            circle.className = "sv-step-circle";
            if (i < currentStep) {
                circle.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1f2937" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            } else {
                circle.textContent = i + 1;
            }

            const label = document.createElement("span");
            label.className = "sv-step-label";
            label.textContent = title;

            item.appendChild(circle);
            item.appendChild(label);
            item.addEventListener("click", () => {
                if (i <= currentStep) {
                    currentStep = i;
                    applyQuestionRules();
                    updateStepView();
                }
            });
            container.appendChild(item);

            if (i < sectionTitles.length - 1) {
                const line = document.createElement("div");
                line.className = "sv-step-line";
                container.appendChild(line);
            }
        });
    }

    function updateStepView() {
        steps.forEach((step, idx) => {
            const isActive = idx === currentStep;
            step.classList.toggle("active", isActive);

            step.querySelectorAll("input, select, textarea").forEach(inp => {
                const ruleHidden = inp.dataset.ruleHidden === "1";
                inp.disabled = ruleHidden;
                if (inp.tagName === 'SELECT' && inp.nextElementSibling?.classList.contains('sv-select')) {
                    inp.nextElementSibling.classList.toggle('disabled', ruleHidden);
                }
            });
        });

        document.getElementById("btnPrev").disabled = currentStep === 0;
        document.getElementById("btnNext").style.display = currentStep === totalSteps - 1 ? "none" : "inline-block";
        document.getElementById("btnSubmit").style.display = currentStep === totalSteps - 1 ? "inline-block" : "none";

        renderStepper();
    }

    function validateCurrentStep() {
        const step = steps[currentStep];
        const invalidField = Array.from(step.querySelectorAll("input, select, textarea"))
            .find(inp => !inp.disabled && !inp.checkValidity());

        if (invalidField) {
            const customWrap = invalidField.tagName === 'SELECT' ? invalidField.nextElementSibling : null;

            if (customWrap && customWrap.classList.contains('sv-select')) {
                customWrap.classList.remove('sv-select--invalid');
                void customWrap.offsetWidth;
                customWrap.classList.add('sv-select--invalid');
                customWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
                customWrap.querySelector('.sv-select__trigger').focus();
            } else {
                invalidField.reportValidity();
            }
            return false;
        }
        return true;
    }

    document.getElementById("btnNext").addEventListener("click", () => {
        if (!validateCurrentStep()) return;
        if (currentStep < totalSteps - 1) {
            currentStep++;
            applyQuestionRules();
            updateStepView();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    document.getElementById("btnPrev").addEventListener("click", () => {
        if (currentStep > 0) {
            currentStep--;
            applyQuestionRules();
            updateStepView();
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    });

    document.getElementById("surveyForm").addEventListener("submit", (e) => {
        if (!validateCurrentStep()) {
            e.preventDefault();
            return;
        }
        const elDuration = document.getElementById('sfDuration');
        if (elDuration) elDuration.value = Math.round((Date.now() - sfStartTime) / 1000);
    });

    document.addEventListener("change", () => {
        applyQuestionRules();
        updateStepView();
    });

    document.addEventListener("DOMContentLoaded", () => {
        enhanceSelects();
        applyQuestionRules();
        updateStepView();

        const elDeviceId = document.getElementById('sfDeviceId');
        if (elDeviceId) elDeviceId.value = navigator.userAgent;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                pos => {
                    const elLat = document.getElementById('sfLatitude');
                    const elLng = document.getElementById('sfLongitude');
                    if (elLat) elLat.value = pos.coords.latitude;
                    if (elLng) elLng.value = pos.coords.longitude;
                },
                () => { /* user nolak izin lokasi, biarin kosong */ }
            );
        }
    });

function enhanceSelects(){
    document.querySelectorAll('.sv-inline-box select').forEach(nativeSelect => {
        if (nativeSelect.dataset.enhanced) return;
        try {
            nativeSelect.dataset.enhanced = "1";

            const wrap = document.createElement('div');
            wrap.className = 'sv-select';

            const trigger = document.createElement('div');
            trigger.className = 'sv-select__trigger';
            trigger.tabIndex = 0;

            const label = document.createElement('span');
            const arrow = document.createElement('i');
            arrow.className = 'bi bi-chevron-down';
            trigger.appendChild(label);
            trigger.appendChild(arrow);

            const panel = document.createElement('div');
            panel.className = 'sv-select__panel';

            function renderOptions(){
                panel.innerHTML = '';
                Array.from(nativeSelect.options).forEach(opt => {
                    const item = document.createElement('div');
                    item.className = 'sv-select__option' + (opt.value === nativeSelect.value ? ' selected' : '');
                    item.textContent = opt.textContent;
                    item.addEventListener('click', () => {
                        nativeSelect.value = opt.value;
                        nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
                        syncLabel();
                        wrap.classList.remove('open');
                        wrap.classList.remove('sv-select--invalid');
                    });
                    panel.appendChild(item);
                });
            }

            function syncLabel(){
                const selectedOpt = nativeSelect.options[nativeSelect.selectedIndex];
                label.textContent = selectedOpt ? selectedOpt.textContent : '';
                trigger.classList.toggle('is-empty', !nativeSelect.value);
                renderOptions();
            }

            trigger.addEventListener('click', () => {
                if (nativeSelect.disabled) return;
                document.querySelectorAll('.sv-select.open').forEach(o => { if (o !== wrap) o.classList.remove('open'); });
                wrap.classList.toggle('open');
            });
            trigger.addEventListener('keydown', (e) => {
                if (nativeSelect.disabled) return;
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger.click(); }
                if (e.key === 'Escape') wrap.classList.remove('open');
            });

            wrap.appendChild(trigger);
            wrap.appendChild(panel);
            nativeSelect.insertAdjacentElement('afterend', wrap);

            nativeSelect.setAttribute('data-enhanced', '1');
            syncLabel();
            nativeSelect.addEventListener('change', syncLabel);
        } catch (err) {
            console.error('Gagal enhance select:', nativeSelect.name, err);
            nativeSelect.style.display = '';
        }
    });

    document.addEventListener('click', (e) => {
        document.querySelectorAll('.sv-select.open').forEach(w => {
            if (!w.contains(e.target)) w.classList.remove('open');
        });
    });
}
</script>
}