@model SurveyFormApp.Models.SurveyResponse
@{
    ViewData["Title"] = "Detail Jawaban";
    ViewData["ActiveMenu"] = "responses";
    Layout = "_SidebarLayout";
}

@section Styles {
<style>
.sv-sticky-block{
  position:sticky;
  top:var(--topbar-h);
  z-index:401;
  background:#EEF2F7;
  padding-top:10px;
  margin-top:-10px;
}
.sv-response-info.sv-card{
  margin-bottom:0;
  border-bottom-left-radius:0;
  border-bottom-right-radius:0;
  box-shadow:var(--shadow-md);
}
.sv-answers-card{
  margin-top:0;
  border-top-left-radius:0;
  border-top-right-radius:0;
}
.sv-answers-footer{
  border-top:1px solid var(--border);
}

/* Nav sekarang jadi baris header tabel, bukan ngambang di luar card */
.sv-answers-header{
  position:sticky;
  top:var(--topbar-h);
  z-index:402;
  background:#fff;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 32px;
  border-bottom:1px solid var(--border);
}
.sv-answers-col-labels{
  display:flex;gap:32px;
  font-size:12px;font-weight:700;text-transform:uppercase;
  letter-spacing:.04em;color:var(--ink-faint);
}
.sv-table--no-head thead{display:none;}
.sv-answers-header__title{font-size:15px;font-weight:700;color:var(--ink);}

.sv-table-nav{
  display:flex;align-items:center;gap:10px;
}
.sv-table-nav__btn{
  width:30px;height:30px;border-radius:8px;border:1px solid var(--border);
  background:#f8fafc;color:var(--ink-soft);display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:.15s;
}
.sv-table-nav__btn:hover:not(:disabled){border-color:var(--sf-purple);color:var(--sf-purple);}
.sv-table-nav__btn:disabled{opacity:.35;cursor:not-allowed;}
.sv-table-nav__label{font-size:13.5px;font-weight:700;color:var(--ink);white-space:nowrap;}
.sv-table-nav__input{
  width:34px;text-align:center;border:1px solid var(--border);border-radius:6px;
  font-size:13.5px;font-weight:700;color:var(--ink);padding:4px 2px;
  -moz-appearance:textfield;
}
.sv-table-nav__input::-webkit-outer-spin-button,
.sv-table-nav__input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
.sv-table-nav__input:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 2px var(--purple-tint);}
.sv-table-nav__input:disabled{background:#f3f4f6;color:var(--ink-faint);cursor:not-allowed;}
</style>
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <p class="sv-eyebrow">Daftar Jawaban</p>
        <h1 class="sv-title mb-0">Detail Jawaban</h1>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-action="Responses" class="sv-btn sv-btn--ghost sv-btn--sm">
            <i class="bi bi-arrow-left"></i> Kembali ke Daftar Jawaban
        </a>
        <form asp-action="DeleteResponse" method="post" onsubmit="return confirm('Hapus jawaban survey ini beserta seluruh datanya? Tindakan ini tidak bisa dibatalkan.');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="sv-btn sv-btn--danger sv-btn--sm">
                <i class="bi bi-trash"></i> Hapus Response
            </button>
        </form>
    </div>
</div>

<div class="sv-sticky-block">
    <div class="sv-card sv-response-info" id="svResponseInfo">
        <p><strong>Form:</strong> @Model.Assignment?.FormVersion?.Form?.FormName</p>
        <p><strong>Surveyor:</strong> @Model.SurveyorId</p>
        <p><strong>Waktu Submit:</strong> @Model.SubmittedAt</p>
    </div>
</div>

@if (Model.SurveyScore != null || Model.SurveyGeoValidation != null || (Model.SurveyFraudFlags != null && Model.SurveyFraudFlags.Any()))
{
    <div class="sv-card">
        <strong class="d-block mb-2">Info Tambahan</strong>
        @if (Model.SurveyScore != null)
        {
            <p class="mb-1"><strong>Skor Total:</strong> @Model.SurveyScore.ScoreTotal</p>
        }
        @if (Model.SurveyGeoValidation != null)
        {
            <p class="mb-1">
                <strong>Validasi Lokasi:</strong>
                @(Model.SurveyGeoValidation.IsValid ? "Valid" : "Tidak Valid")
                (jarak @Model.SurveyGeoValidation.DistanceMeters.ToString("N0") m)
            </p>
        }
        @if (Model.SurveyFraudFlags != null && Model.SurveyFraudFlags.Any())
        {
            <p class="mb-1"><strong>Flag Kecurangan:</strong></p>
            <ul class="mb-0">
                @foreach (var flag in Model.SurveyFraudFlags)
                {
                    <li>@flag.FlagCode — @flag.Description</li>
                }
            </ul>
        }
    </div>
}

<div class="sv-card sv-answers-card p-0">
<div class="sv-answers-header" id="answersHeaderBar">
    <div class="sv-answers-col-labels">
        <span>Section</span>
        <span>Pertanyaan</span>
        <span>Jawaban</span>
    </div>
    <div class="sv-table-nav" id="answersNav">
        <button type="button" class="sv-table-nav__btn" id="btnAnswersPrev" title="Halaman sebelumnya">
            <i class="bi bi-chevron-left"></i>
        </button>
        <span class="sv-table-nav__label">
            Hal <input type="number" class="sv-table-nav__input" id="answersNavInput" min="1" value="1" />
            dari <span id="answersNavTotal">1</span>
        </span>
        <button type="button" class="sv-table-nav__btn" id="btnAnswersNext" title="Halaman selanjutnya">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>
    <div class="px-4">
    <table class="sv-table sv-table--no-head">
        <tbody id="answersTbody">
            @foreach (var a in Model.SurveyAnswers.OrderBy(a => a.Question.OrderNo))
            {
                <tr>
                    <td>@a.Question?.Section?.SectionTitle</td>
                    <td>@a.Question?.QuestionText</td>
                    <td>@(a.ValueText ?? a.ValueNumber?.ToString() ?? a.ValueDate?.ToString() ?? a.ValueBoolean?.ToString() ?? "-")</td>
                    <td class="text-nowrap">
                        <a asp-action="EditAnswer" asp-route-id="@a.Id" class="sv-btn sv-btn--ghost sv-btn--sm">Edit</a>
                        <form asp-action="DeleteAnswer" method="post" style="display:inline" onsubmit="return confirm('Hapus jawaban ini?');">
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="responseId" value="@Model.Id" />
                            <button class="sv-btn sv-btn--danger sv-btn--sm">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function () {
    function positionHeaderBar() {
        var infoCard = document.getElementById('svResponseInfo');
        var headerBar = document.getElementById('answersHeaderBar');
        if (!infoCard || !headerBar) return;

        var topbarH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--topbar-h')) || 64;
        headerBar.style.top = (topbarH + infoCard.offsetHeight) + 'px';
    }

    positionHeaderBar();
    window.addEventListener('resize', positionHeaderBar);

    initAnswersPager({ tbodyId: 'answersTbody', pageSize: 10 });
});

function initAnswersPager(opts) {
    var pageSize = opts.pageSize || 10;
    var tbody = document.getElementById(opts.tbodyId);
    if (!tbody) return;

    var rows = Array.from(tbody.querySelectorAll('tr'));
    var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    var current = 1;

    var nav = document.getElementById('answersNav');
    var btnPrev = document.getElementById('btnAnswersPrev');
    var btnNext = document.getElementById('btnAnswersNext');
    var input = document.getElementById('answersNavInput');
    var totalLabel = document.getElementById('answersNavTotal');

    if (!nav || !btnPrev || !btnNext || !input || !totalLabel) return;

    if (rows.length <= pageSize) {
        nav.style.display = 'none';
    }

    input.max = totalPages;
    totalLabel.textContent = totalPages;

    function render() {
        rows.forEach(function (row, idx) {
            var page = Math.floor(idx / pageSize) + 1;
            row.style.display = page === current ? '' : 'none';
        });
        input.value = current;
        btnPrev.disabled = current === 1;
        btnNext.disabled = current === totalPages;
    }

    function goTo(page) {
        page = Math.max(1, Math.min(totalPages, page));
        current = page;
        render();
    }

    btnPrev.addEventListener('click', function () { goTo(current - 1); });
    btnNext.addEventListener('click', function () { goTo(current + 1); });
    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            goTo(parseInt(input.value, 10) || 1);
            input.blur();
        }
    });
    input.addEventListener('blur', function () {
        goTo(parseInt(input.value, 10) || 1);
    });

    render();
}
</script>