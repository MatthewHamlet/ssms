@model SurveyFormApp.Models.SurveyAnswer
@{
    ViewData["Title"] = "Edit Jawaban";
    ViewData["ActiveMenu"] = "responses";
    Layout = "_SidebarLayout";
    var qType = Model.Question.QuestionType?.ToLower() ?? "text";
}

<p class="sv-eyebrow">Daftar Jawaban</p>
<h1 class="sv-title">Edit Jawaban</h1>

<div class="sv-card">
    <p class="mb-3"><strong>Pertanyaan:</strong> @Model.Question.QuestionText</p>

    <form asp-action="EditAnswer" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        @if (qType == "number")
        {
            <label class="form-label">Jawaban (angka)</label>
            <input type="number" step="any" name="valueNumber" class="form-control" value="@Model.ValueNumber" />
        }
        else if (qType == "date")
        {
            <label class="form-label">Jawaban (tanggal)</label>
            <input type="date" name="valueDate" class="form-control" value="@(Model.ValueDate?.ToString("yyyy-MM-dd"))" />
        }
        else if (qType == "boolean")
        {
            <label class="form-label">Jawaban</label>
            <select name="valueBoolean" class="form-select">
                <option value="">-- Pilih --</option>
                <option value="true" selected="@(Model.ValueBoolean == true)">Ya</option>
                <option value="false" selected="@(Model.ValueBoolean == false)">Tidak</option>
            </select>
        }
        else if (qType == "dropdown" && Model.Question.SurveyQuestionOptions.Any())
        {
            <label class="form-label">Jawaban</label>
            <select name="valueText" class="form-select">
                @foreach (var opt in Model.Question.SurveyQuestionOptions.OrderBy(o => o.OrderNo))
                {
                    <option value="@opt.OptionValue" selected="@(Model.ValueText == opt.OptionValue)">@opt.OptionLabel</option>
                }
            </select>
        }
        else if (qType == "textarea")
        {
            <label class="form-label">Jawaban</label>
            <textarea name="valueText" class="form-control" rows="4">@Model.ValueText</textarea>
        }
        else
        {
            <label class="form-label">Jawaban</label>
            <input name="valueText" class="form-control" value="@Model.ValueText" />
        }

        <div class="mt-3">
            <button type="submit" class="sv-btn sv-btn--primary">Simpan</button>
            <a asp-action="ResponseDetail" asp-route-id="@Model.ResponseId" class="sv-btn sv-btn--ghost">Batal</a>
        </div>
    </form>
</div>