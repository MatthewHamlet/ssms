@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Terima Kasih — Fiscus Multifinance</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{
    font-family:'Inter',sans-serif;
    background:#EEF2F7;
    color:#111827;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
}
.ty-card{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:16px;
    box-shadow:0 4px 16px rgba(0,0,0,.08);
    padding:48px 40px;
    text-align:center;
    max-width:420px;
    width:100%;
}
.ty-icon{
    width:64px;height:64px;border-radius:50%;
    background:#00C9B1;
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 20px;
    color:#fff;
    font-size:28px;
}
.ty-title{font-size:20px;font-weight:800;color:#111827;margin-bottom:8px;}
.ty-desc{font-size:14px;color:#6b7280;margin-bottom:28px;line-height:1.6;}
.ty-btn{
    display:inline-block;
    background:#0A2540;
    color:#fff;
    font-weight:600;
    font-size:14.5px;
    padding:11px 26px;
    border-radius:8px;
    text-decoration:none;
    transition:.15s;
}
.ty-btn:hover{background:#1a3a5c;color:#fff;}
</style>
</head>
<body>
    <div class="ty-card">
        <div class="ty-icon"><i class="bi bi-check-lg"></i></div>
        <h1 class="ty-title">Survey Berhasil Dikirim</h1>
        <p class="ty-desc">Terima kasih, jawaban survey kamu sudah tersimpan.</p>
        <a asp-controller="Survey" asp-action="Index" class="ty-btn">Kembali ke Daftar Form</a>
    </div>
</body>
</html>