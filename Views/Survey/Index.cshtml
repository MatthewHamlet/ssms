@model List<SurveyFormApp.Models.SurveyAssignment>
@{
    ViewData["Title"] = "Daftar Form";
    ViewData["ActiveMenu"] = "surveyindex";
    Layout = "_SidebarLayout";
    var currentSurveyor = ViewData["CurrentSurveyor"] as string;
}

@section Styles {
<style>
.sf-table-wrap{overflow-x:auto;}
.sf-table{width:100%;border-collapse:collapse;}
.sf-table thead th{
  text-align:left;font-size:12px;font-weight:700;text-transform:uppercase;
  letter-spacing:.04em;color:var(--ink-faint);
  padding:0 16px 12px;border-bottom:2px solid var(--border);
}
.sf-table tbody td{
  padding:16px;border-bottom:1px solid var(--border);
  font-size:14.5px;color:var(--ink);vertical-align:middle;
}
.sf-table tbody tr:last-child td{border-bottom:none;}
.sf-table tbody tr:hover{background:#fafbfc;}
.sf-form-code{
  display:inline-block;font-size:12px;font-weight:700;color:var(--sf-purple);
  background:var(--purple-tint);padding:3px 9px;border-radius:6px;
}
.sf-form-name{font-weight:600;}
.sf-badge{
  display:inline-block;font-size:12px;font-weight:600;color:var(--ink-soft);
  background:#f1f5f9;padding:3px 10px;border-radius:20px;
}
.sf-fill-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--sf-gold);color:#0f172a;font-weight:700;font-size:13.5px;
  padding:9px 16px;border-radius:8px;text-decoration:none;transition:.15s;
}
.sf-fill-btn:hover{background:var(--sf-gold-dark);color:#0f172a;}
.sf-empty{text-align:center;padding:60px 20px;color:var(--ink-faint);}
.sf-empty i{font-size:38px;display:block;margin-bottom:12px;color:var(--ink-faint);}
.sv-surveyor-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:18px;}
.sv-surveyor-name{font-weight:700;color:var(--ink);}

@@media(max-width:768px){
  .sf-table thead{display:none;}
  .sf-table, .sf-table tbody, .sf-table tr, .sf-table td{display:block;width:100%;}
  .sf-table tbody tr{border:1px solid var(--border);border-radius:12px;margin-bottom:12px;padding:14px;}
  .sf-table tbody td{border-bottom:none;padding:6px 0;}
  .sf-fill-btn{width:100%;justify-content:center;margin-top:8px;}
}
</style>
}

<p class="sv-eyebrow">Survei Digital</p>
<h1 class="sv-title">Daftar Form Survey</h1>

@if (string.IsNullOrWhiteSpace(currentSurveyor))
{
    <div class="sv-card">
        <p class="mb-3">Masukkan nama kamu sebagai surveyor untuk melihat form survey yang ditugaskan ke kamu.</p>
        <form asp-action="SetSurveyor" method="post" class="row g-2">
            <div class="col-md-6">
                <input name="surveyorName" class="form-control" placeholder="Nama kamu" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="sv-btn sv-btn--primary">Masuk</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="sv-surveyor-bar">
        <span>Masuk sebagai: <span class="sv-surveyor-name">@currentSurveyor</span></span>
        <form asp-action="Logout" method="post">
            <button type="submit" class="sv-btn sv-btn--ghost sv-btn--sm">Ganti Surveyor</button>
        </form>
    </div>

    <div class="sv-card">
        @if (Model != null && Model.Count > 0)
        {
            <div class="sf-table-wrap">
                <table class="sf-table">
                    <thead>
                        <tr><th>Application ID</th><th>Nama Form</th><th>Cabang</th><th>Batas Waktu</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><span class="sf-form-code">@a.ApplicationId</span></td>
                                <td class="sf-form-name">@a.FormVersion?.Form?.FormName</td>
                                <td><span class="sf-badge">@(a.BranchId ?? "-")</span></td>
                                <td>@(a.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    <a asp-action="Fill" asp-route-id="@a.Id" class="sf-fill-btn">
                                        <i class="bi bi-pencil-square"></i> Isi Form
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="sf-empty">
                <i class="bi bi-inbox"></i>
                Belum ada survey yang ditugaskan ke kamu.
            </div>
        }
    </div>
}