@model SurveyFormApp.Models.SurveyResponseListViewModel
@{
    ViewData["Title"] = "Daftar Jawaban";
    ViewData["ActiveMenu"] = "responses";
    Layout = "_SidebarLayout";
}

@section Styles {
<style>
.sf-table-wrap{overflow-x:auto;}
.sf-table{width:100%;border-collapse:collapse;}
.sf-table thead th{
  text-align:left;font-size:12px;font-weight:700;text-transform:uppercase;
  letter-spacing:.04em;color:var(--ink-faint);
  padding:0 16px 12px;border-bottom:2px solid var(--border);
}
.sf-table tbody td{
  padding:16px;border-bottom:1px solid var(--border);
  font-size:14.5px;color:var(--ink);vertical-align:middle;
}
.sf-table tbody tr:last-child td{border-bottom:none;}
.sf-table tbody tr:hover{background:#fafbfc;}
.sf-form-name{font-weight:600;}
.sf-surveyor{color:var(--ink-soft);}
.sf-submitted{color:var(--ink-soft);font-size:13.5px;}

.sf-status{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12px;font-weight:700;padding:4px 11px;border-radius:20px;
  text-transform:capitalize;
}
.sf-status i{font-size:8px;}
.sf-status--submitted{background:#e6f9f5;color:#00a896;}
.sf-status--pending{background:#fff6e0;color:#8a5a00;}
.sf-status--default{background:#f1f5f9;color:var(--ink-soft);}

.sf-detail-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--sf-purple);color:#fff;font-weight:700;font-size:13.5px;
  padding:9px 16px;border-radius:8px;text-decoration:none;transition:.15s;
}
.sf-detail-btn:hover{background:var(--sf-purple-2);color:#fff;}

.sf-empty{text-align:center;padding:60px 20px;color:var(--ink-faint);}
.sf-empty i{font-size:38px;display:block;margin-bottom:12px;color:var(--ink-faint);}

.sv-filter-bar{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px;align-items:flex-end;}
.sv-filter-bar .sv-filter-field{min-width:160px;}
.sv-simple-pager{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-top:14px;}
.sv-simple-pager__label{font-size:13.5px;font-weight:700;color:var(--ink);}

@@media(max-width:768px){
  .sf-table thead{display:none;}
  .sf-table, .sf-table tbody, .sf-table tr, .sf-table td{display:block;width:100%;}
  .sf-table tbody tr{border:1px solid var(--border);border-radius:12px;margin-bottom:12px;padding:14px;}
  .sf-table tbody td{border-bottom:none;padding:6px 0;}
  .sf-detail-btn{width:100%;justify-content:center;margin-top:8px;}
}
</style>
}

<p class="sv-eyebrow">Survei Digital</p>
<h1 class="sv-title">Daftar Jawaban Survey</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="sv-card">
    <form method="get" asp-action="Responses" class="sv-filter-bar">
        <div class="sv-filter-field">
            <label class="form-label">Form</label>
            <select name="formId" class="form-select">
                <option value="">Semua Form</option>
                @foreach (var f in Model.AvailableForms)
                {
                    <option value="@f.Id" selected="@(Model.FilterFormId == f.Id)">@f.FormName</option>
                }
            </select>
        </div>
        <div class="sv-filter-field">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">Semua Status</option>
                <option value="SUBMITTED" selected="@(Model.FilterStatus == "SUBMITTED")">Submitted</option>
                <option value="PENDING" selected="@(Model.FilterStatus == "PENDING")">Pending</option>
            </select>
        </div>
        <div class="sv-filter-field">
            <label class="form-label">Surveyor</label>
            <input type="text" name="surveyorName" class="form-control" value="@Model.FilterSurveyorName" placeholder="Cari nama surveyor" />
        </div>
        <div class="sv-filter-field">
            <label class="form-label">Dari Tanggal</label>
            <input type="date" name="dateFrom" class="form-control" value="@(Model.FilterDateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="sv-filter-field">
            <label class="form-label">Sampai Tanggal</label>
            <input type="date" name="dateTo" class="form-control" value="@(Model.FilterDateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="sv-filter-field">
            <button type="submit" class="sv-btn sv-btn--primary">Filter</button>
            <a asp-action="Responses" class="sv-btn sv-btn--ghost">Reset</a>
        </div>
    </form>

    @if (Model.Items.Count > 0)
    {
        <div class="sf-table-wrap">
            <table class="sf-table">
                <thead>
                    <tr><th>Form</th><th>Surveyor</th><th>Status</th><th>Waktu Submit</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        var statusClass = (r.Status?.ToUpper()) switch
                        {
                            "SUBMITTED" => "sf-status--submitted",
                            "PENDING" => "sf-status--pending",
                            _ => "sf-status--default"
                        };

                        <tr>
                            <td class="sf-form-name">@r.Assignment?.FormVersion?.Form?.FormName</td>
                            <td class="sf-surveyor">@r.SurveyorId</td>
                            <td><span class="sf-status @statusClass"><i class="bi bi-circle-fill"></i>@r.Status</span></td>
                            <td class="sf-submitted">@(r.SubmittedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</td>
                            <td class="text-nowrap">
                                <a asp-action="ResponseDetail" asp-route-id="@r.Id" class="sf-detail-btn">
                                    <i class="bi bi-eye-fill"></i> Lihat Detail
                                </a>
                                <form asp-action="DeleteResponse" method="post" style="display:inline" onsubmit="return confirm('Hapus jawaban survey ini beserta seluruh datanya? Tindakan ini tidak bisa dibatalkan.');">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="sv-btn sv-btn--danger sv-btn--sm">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="sv-simple-pager">
            @{
                var prevDisabled = Model.CurrentPage <= 1;
                var nextDisabled = Model.CurrentPage >= Model.TotalPages;
                var routeValues = new Dictionary<string, string?>
                {
                    ["formId"] = Model.FilterFormId?.ToString(),
                    ["status"] = Model.FilterStatus,
                    ["surveyorName"] = Model.FilterSurveyorName,
                    ["dateFrom"] = Model.FilterDateFrom?.ToString("yyyy-MM-dd"),
                    ["dateTo"] = Model.FilterDateTo?.ToString("yyyy-MM-dd")
                };
            }
            <a class="sv-btn sv-btn--ghost sv-btn--sm"
               asp-action="Responses" asp-all-route-data="routeValues" asp-route-page="@(Model.CurrentPage - 1)"
               style="@(prevDisabled ? "pointer-events:none;opacity:.4;" : "")">
                <i class="bi bi-chevron-left"></i> Sebelumnya
            </a>
            <span class="sv-simple-pager__label">Halaman @Model.CurrentPage dari @(Math.Max(Model.TotalPages, 1))</span>
            <a class="sv-btn sv-btn--ghost sv-btn--sm"
               asp-action="Responses" asp-all-route-data="routeValues" asp-route-page="@(Model.CurrentPage + 1)"
               style="@(nextDisabled ? "pointer-events:none;opacity:.4;" : "")">
                Selanjutnya <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    }
    else
    {
        <div class="sf-empty">
            <i class="bi bi-inbox"></i>
            Belum ada jawaban survey yang cocok dengan filter ini.
        </div>
    }
</div>