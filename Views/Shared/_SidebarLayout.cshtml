@{
    Layout = null;
    string activeMenu = ViewData["ActiveMenu"] as string ?? "";
    bool IsActive(string key) => activeMenu == key;
}
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>@ViewData["Title"] — Fiscus Multifinance</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:#EEF2F7;color:#111827;font-size:14px;line-height:1.5;overflow-x:hidden}

:root{
  --sf-purple:#0A2540;
  --sf-purple-2:#1a3a5c;
  --sf-gold:#00C9B1;
  --sf-gold-dark:#00a896;
  --sidebar-w:264px;
  --sidebar-col:72px;
  --topbar-h:64px;
  --border:#e5e7eb;
  --ink:#111827;
  --ink-soft:#6b7280;
  --ink-faint:#9ca3af;
  --danger:#dc2626;
  --purple:var(--sf-purple);
  --purple-dark:#210a4d;
  --purple-tint:#efeafb;
  --r:10px;
  --shadow-sm:0 1px 4px rgba(0,0,0,.06);
  --shadow-md:0 4px 16px rgba(0,0,0,.08);
  --ease:cubic-bezier(.4,0,.2,1);
}

/* ═══════ SIDEBAR ═══════ */
#sfSidebar{
  position:fixed;top:0;left:0;bottom:0;
  width:var(--sidebar-w);
  background:linear-gradient(180deg,var(--sf-purple),var(--sf-purple-2));
  z-index:1000;
  display:flex;flex-direction:column;
  transition:width .28s var(--ease);
  overflow:hidden;
  box-shadow:4px 0 20px rgba(0,0,0,.18);
}
#sfSidebar.collapsed{width:var(--sidebar-col);}

.sf-logo{
  display:flex;align-items:center;gap:12px;
  padding:0 18px;height:var(--topbar-h);
  border-bottom:1px solid rgba(255,255,255,.08);
  flex-shrink:0;white-space:nowrap;overflow:hidden;
}
.sf-logo-icon{
  width:36px;height:36px;border-radius:10px;flex-shrink:0;
  background:var(--sf-gold);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;font-weight:800;color:#fff;
}
.sf-logo-text{font-size:18px;font-weight:800;color:#fff;letter-spacing:-.5px;transition:opacity .2s;}
.sf-logo-text em{color:var(--sf-gold);font-style:normal;}
#sfSidebar.collapsed .sf-logo-text{opacity:0;pointer-events:none;}

.sf-scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:14px 0 6px;}
.sf-scroll::-webkit-scrollbar{width:0;}

.sf-section{
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;
  color:rgba(255,255,255,.32);padding:16px 20px 6px;
  white-space:nowrap;overflow:hidden;transition:opacity .2s;
}
#sfSidebar.collapsed .sf-section{opacity:0;}

.sf-item{
  display:flex;align-items:center;gap:12px;
  padding:11px 16px;margin:2px 10px;
  color:rgba(255,255,255,.62);border-radius:10px;
  cursor:pointer;white-space:nowrap;overflow:hidden;
  transition:.18s var(--ease);position:relative;text-decoration:none;
}
.sf-item:hover{background:rgba(255,255,255,.08);color:#fff;}
.sf-item.active{
  background:rgba(0,201,177,.15);
  color:var(--sf-gold);font-weight:700;
}
.sf-item.active::before{
  content:'';position:absolute;left:-10px;top:50%;transform:translateY(-50%);
  width:4px;height:22px;background:var(--sf-gold);border-radius:0 4px 4px 0;
}
.sf-item i{font-size:16px;flex-shrink:0;width:20px;text-align:center;}
.sf-label{font-size:13.5px;transition:opacity .2s;flex:1;}
#sfSidebar.collapsed .sf-label{opacity:0;width:0;}

.sv-tag-input{border:1px solid var(--border);border-radius:8px;padding:8px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;background:#fff;cursor:text;}
.sv-tag-input:focus-within{border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-tint);}
.sv-tag-chip{display:inline-flex;align-items:center;gap:4px;background:var(--purple-tint);color:var(--purple);font-size:13px;font-weight:600;padding:5px 6px 5px 12px;border-radius:20px;white-space:nowrap;}
.sv-tag-remove{border:none;background:transparent;color:var(--purple);font-size:16px;line-height:1;cursor:pointer;padding:2px 5px;border-radius:50%;}
.sv-tag-remove:hover{background:var(--purple);color:#fff;}
.sv-tag-typer{border:none;outline:none;flex:1 1 140px;font-size:14px;padding:4px 2px;min-width:140px;background:transparent;}

.sf-footer{padding:14px 10px;border-top:1px solid rgba(255,255,255,.08);flex-shrink:0;}
.sf-user{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px;white-space:nowrap;overflow:hidden;}
.sf-avatar{
  width:34px;height:34px;border-radius:50%;flex-shrink:0;
  background:var(--sf-gold);
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-weight:800;font-size:12px;
}
.sf-uname{color:#fff;font-size:13px;font-weight:700;}
.sf-urole{color:rgba(255,255,255,.45);font-size:11px;}

/* ═══════ MAIN WRAP ═══════ */
#sfWrap{margin-left:var(--sidebar-w);transition:margin-left .28s var(--ease);min-height:100vh;display:flex;flex-direction:column;}
#sfWrap.collapsed{margin-left:var(--sidebar-col);}

#sfTopbar{
  height:var(--topbar-h);background:#fff;border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 24px;gap:14px;
  position:sticky;top:0;z-index:500;box-shadow:var(--shadow-sm);
}
.sf-toggle{
  width:36px;height:36px;border:1.5px solid var(--border);background:#f8fafc;
  border-radius:8px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--ink-soft);transition:.18s;flex-shrink:0;
}
.sf-toggle:hover{border-color:var(--sf-purple);color:var(--sf-purple);}
.sf-topbar-title{font-size:14.5px;font-weight:700;color:var(--ink);}

#sfContent{flex:1;padding:28px 28px 40px;}

.sv-page{font-family:'Inter',sans-serif;}
.sv-eyebrow{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 6px;}
.sv-title{font-size:22px;font-weight:800;margin:0 0 22px;color:var(--ink);}

.sv-card{
  background:#fff;border:1px solid var(--border);border-radius:16px;
  box-shadow:var(--shadow-sm);padding:28px 32px;margin-bottom:24px;
}

.sv-btn{font-family:inherit;font-size:14px;font-weight:600;border-radius:8px;padding:9px 18px;cursor:pointer;border:1px solid transparent;transition:.15s;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
.sv-btn--ghost{background:transparent;border-color:var(--border);color:var(--ink-soft);}
.sv-btn--ghost:hover{border-color:#c4c4c8;color:var(--ink);}
.sv-btn--primary{background:var(--purple);color:#fff;}
.sv-btn--primary:hover{background:var(--purple-dark);color:#fff;}
.sv-btn--submit{background:var(--sf-gold);color:#1f2937;}
.sv-btn--submit:hover{filter:brightness(.97);}
.sv-btn--danger{background:#fff;border-color:#f3c2c2;color:var(--danger);}
.sv-btn--danger:hover{background:#fef2f2;}
.sv-btn--sm{padding:6px 12px;font-size:12.5px;}

table.sv-table{width:100%;border-collapse:collapse;}
table.sv-table th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-faint);border-bottom:1px solid var(--border);padding:10px 12px;}
table.sv-table td{padding:12px;border-bottom:1px solid #f1f2f4;font-size:14px;vertical-align:top;}
table.sv-table tr:hover td{background:#fafbfc;}

.form-label{font-weight:600;font-size:13.5px;color:var(--ink);margin-bottom:6px;display:block;}
.form-control,.form-select{border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:14px;width:100%;}
.form-control:focus,.form-select:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-tint);}

.sv-badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11.5px;font-weight:700;}
.sv-badge--draft{background:#fff6e0;color:#8a5a00;}
.sv-badge--published{background:#e6faf6;color:#00806e;}

@@media(max-width:768px){
  #sfSidebar{transform:translateX(-100%);width:var(--sidebar-w) !important;}
  #sfSidebar.mobile-open{transform:translateX(0);}
  #sfWrap{margin-left:0 !important;}
  .sv-card{padding:20px;}
}
</style>
@await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav id="sfSidebar">
  <div class="sf-logo">
    <div class="sf-logo-icon">FM</div>
    <span class="sf-logo-text">Fiscus<em>Multifinance</em></span>
  </div>
  <div class="sf-scroll">
    <div class="sf-section">Menu</div>
    <a class="sf-item @(IsActive("home") ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill"></i><span class="sf-label">Beranda</span></a>
    <a class="sf-item @(IsActive("surveyindex") ? "active" : "")" asp-controller="Survey" asp-action="Index"><i class="bi bi-grid-fill"></i><span class="sf-label">Daftar Form</span></a>
    <a class="sf-item @(IsActive("formbuilder") ? "active" : "")" asp-controller="FormBuilder" asp-action="Index"><i class="bi bi-tools"></i><span class="sf-label">Form Builder</span></a>
    <a class="sf-item @(IsActive("responses") ? "active" : "")" asp-controller="Survey" asp-action="Responses"><i class="bi bi-clipboard-data-fill"></i><span class="sf-label">Daftar Jawaban</span></a>
    <div class="sf-section">Lainnya</div>
    <a class="sf-item @(IsActive("privacy") ? "active" : "")" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-fill"></i><span class="sf-label">Privasi</span></a>
  </div>
  <div class="sf-footer">
    <div class="sf-user">
      <div class="sf-avatar">AD</div>
      <div><div class="sf-uname">Admin</div><div class="sf-urole">Form Manager</div></div>
    </div>
  </div>
</nav>

<div id="sfWrap">
  <nav id="sfTopbar">
    <button class="sf-toggle" onclick="sfToggleSidebar()"><i class="bi bi-list" style="font-size:17px;"></i></button>
    <div class="sf-topbar-title">@ViewData["Title"]</div>
  </nav>
  <div id="sfContent">
    <div class="sv-page">
      @RenderBody()
    </div>
  </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
function sfToggleSidebar(){
    document.getElementById('sfSidebar').classList.toggle('collapsed');
    document.getElementById('sfWrap').classList.toggle('collapsed');
}
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>